@component-name = "portal-web-forms-and-data-lists"
definition {
    property testray.main.component.name = "Forms";

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

    tearDown {
        User.logoutAndLoginPG(
            userLoginEmailAddress = "test@liferay.com",
            userLoginFullName = "Test Test");
    }

  @description = "Create a Form Change Language Publish And Validate"
	@priority = 5

    test CreateFormChangeLanguagePublishAndValidate {

        FormsAdmin.addForm();

        Form.editName(formName = "Test");

        Form.addTextField(fieldPositionNumber = 0);

        Form.editFieldLabelMetal(fieldValue = "Full Name");

        Form.closeSidebar();

        Form.gotoAddField(
			fieldPositionNumber = 1,
			fieldType = "Numeric");

        Form.editFieldLabelMetal(fieldValue = "Age");

        Form.addTranslation(localizedLanguage = "Portuguese (Brazil)");

        Form.closeSidebar();

        Click(
			key_name = "Full Name",
			locator1 = "FormFields#FIELD_TARGET_LABEL");

		Form.editFieldLabelMetal(fieldValue = "Nome Completo");

    

        Click(
			key_name = "Age",
			locator1 = "FormFields#FIELD_TARGET_LABEL");

        Form.editFieldLabelMetal(fieldValue = "Idade");

        Form.save();

        Form.publishForm();

        FormsAdminNavigator.gotoPublishedForm();

        FormViewBuilder.editText(
			fieldName = "Full Name",
			fieldValue = "UserOne");

        FormViewBuilder.editText(
			fieldName = "Age",
			fieldValue = "67");

        FormPortlet.submit();

        Form.submitAgain();

       FormPortlet.changeLocale(locale = "português-Brasil");

        FormViewBuilder.editText(
			fieldName = "Nome Completo",
			fieldValue = "Usuário2");

        FormViewBuilder.editText(
			fieldName = "Idade",
			fieldValue = "67");

        FormPortlet.submit();

        Form.submitAgain();

        Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			portlet = "Forms");

        FormsAdminNavigator.gotoViewEntries();

        LexiconEntry.viewEntryContent(
				rowAny = "UserOne",
				rowEntry = "67");

        LexiconEntry.viewEntryContent(
				rowAny = "Usuário2",
				rowEntry = "67");

    }

}